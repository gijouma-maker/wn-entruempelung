# Kopieren nach .env und ausfüllen (Datei .env NIE auf GitHub hochladen)

# Welche KI?  lokal = eigene KI über Ollama (kostenlos)  ·  anthropic = Claude-API (kostet pro Anfrage)  ·  aus
WN_KI=lokal
# Eigene KI: Adresse von Ollama und Modell (2b = wenig RAM, 4b = ab 8 GB RAM, 8b = ab 16 GB RAM oder Grafikkarte)
WN_OLLAMA_URL=http://127.0.0.1:11434
WN_OLLAMA_MODELL=qwen3-vl:4b

# Nur für WN_KI=anthropic: API-Schlüssel von https://console.anthropic.com
ANTHROPIC_API_KEY=
WN_KI_MODELL=claude-sonnet-5-5
# Max. KI-Anfragen pro Person und Tag (Kostenbremse, nur Anthropic)
WN_KI_LIMIT_TAG=400

# Code für die erste Einrichtung des Chef-Zugangs (install.sh setzt ihn automatisch)
WN_SETUP_CODE=
# Port, auf dem der Server intern läuft (Caddy leitet https dorthin weiter)
PORT=8080

# Datensicherung: Uhrzeiten (mehrmals täglich) und Aufbewahrung in Tagen
WN_SICHERUNG_ZEITEN=6,14,22
WN_SICHERUNG_TAGE=30
# Zweite Kopie außerhalb des Servers (z. B. eingebundene Storage-Box): Ordnerpfad eintragen
WN_SICHERUNG_KOPIE=
